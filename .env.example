# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server and scripts only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OneMap (free account at https://www.onemap.gov.sg/apidocs/register). Server only.
# Used to get an API token for geocoding and walking routes.
ONEMAP_EMAIL=you@example.com
ONEMAP_PASSWORD=your-onemap-password

# Where the app runs. Used for login links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Reminder emails with Resend (free account at https://resend.com). Server only.
# Without a key, reminders still show in the app and the email is printed in the terminal instead.
# The test sender onboarding@resend.dev only delivers to the email you signed up to Resend with.
RESEND_API_KEY=
REMINDER_FROM_EMAIL=TOUCH Meals on Wheels <onboarding@resend.dev>

# Any long random string. The scheduled job sends it to /api/cron/reminders (see README).
CRON_SECRET=
